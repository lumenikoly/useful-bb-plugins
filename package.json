{
  "name": "bb-plugins",
  "private": true,
  "type": "module",
  "workspaces": [
    "plugins/*"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
